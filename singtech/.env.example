# Copy to .env.local. All optional: the app runs fully self-contained without them.
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
SALESFORCE_WEBHOOK_URL=

# News signals (src/lib/signals) use free, keyless feeds only. The keys below are NOT needed;
# they name paid or keyed sources that could replace those feeds later. Nothing reads them today.
# GNews API (gnews.io): licensed news search, a production swap for Google News RSS.
GNEWS_API_KEY=
# NewsData.io: keyed news API with India and Singapore coverage.
NEWSDATA_API_KEY=
# Logo.dev: company logos for account and prospect headers.
LOGO_DEV_TOKEN=
# data.gov.sg: higher rate limits for Singapore open datasets.
DATA_GOV_SG_API_KEY=

# Salesforce Developer Edition (OAuth client credentials) and the Chatter deal-room group.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=
SALESFORCE_DEAL_ROOM_GROUP_ID=
# RAG gateway on the home GPU box, behind a Cloudflare Access tunnel; RAG_GATEWAY_KEY must match ~/singtech-rag/gateway/.env on the box.
RAG_GATEWAY_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
RAG_GATEWAY_KEY=
# Public URL encoded in the Pitch QR (tunnel or LAN address; localhost does not work on phones).
NEXT_PUBLIC_DEAL_ROOM_URL=


# Deal room: hide Chatter posts made before this ISO time (they stay in Salesforce). Empty shows everything.
DEAL_ROOM_SINCE=
