# Copy to .env and adjust. Never commit .env.

# --- Server (apps/server) ---
PORT=8787
NODE_ENV=development

# --- Web (apps/web) ---
# Leave empty in dev: Vite proxies /api -> http://localhost:8787.
# Set to a full origin (e.g. https://api.example.com) when web and API are hosted apart.
VITE_API_BASE_URL=
