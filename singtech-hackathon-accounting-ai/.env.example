# Copy to .env and adjust. Never commit .env.

# --- Server (apps/server) ---
PORT=8787
NODE_ENV=development

# --- Web (apps/web) ---
# Leave empty in dev: Vite proxies /api -> http://localhost:8787.
# Set to a full origin (e.g. https://api.example.com) when web and API are hosted apart.
VITE_API_BASE_URL=

# --- Account Intelligence (apps/server) ---
# Leave both empty to use the built-in simulated data (MockAdapter). Set both to read from Supabase.
# The service-role key is never put here: it is used only by the server-side seeding script.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Fixed "today" for demos (YYYY-MM-DD) so tenure and contract runway never drift on stage.
# Remove or leave empty to use the real clock.
DEMO_TODAY=2026-11-16

# Signs demo sign-in sessions. Set a long random value outside a laptop demo.
# Demo accounts and how sign-in works: docs/account-intelligence/DEMO-LOGIN.md
SESSION_SECRET=
