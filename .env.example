# Copy to .env and adjust. Never commit .env.

PORT=8787
NODE_ENV=development

# Single-user prototype login
DEMO_USER_EMAIL=advisor@telsing.demo
DEMO_USER_PASSWORD=change-this-demo-password
SESSION_SECRET=change-this-to-a-long-random-secret

# RAG
GROQ_API_KEY= 
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX

# Supabase project settings -> API -> Project URL. Backend only.
SUPABASE_URL=
# Backend-only service_role/secret key from Supabase project API settings. Never use a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# pgvector has no separate environment variable. Enable it by running
# supabase/migrations/202611160001_customer_rag.sql in the Supabase SQL editor.

# Web
VITE_API_BASE_URL=
