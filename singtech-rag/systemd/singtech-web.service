[Unit]
Description=SingTech web app (127.0.0.1:3000, published as https://singtech.manansethia.com by cloudflared)
After=network-online.target singtech-rag.service
Wants=singtech-rag.service

[Service]
WorkingDirectory=%h/singtech-app
Environment=NODE_ENV=production
Environment=PATH=%h/.local/share/fnm/node-versions/v20.20.2/installation/bin:/usr/bin:/bin
ExecStart=%h/.local/share/fnm/node-versions/v20.20.2/installation/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
